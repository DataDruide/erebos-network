{
  "manifest_version": 2,
  "name": "Erebos Tunnel Guard",
  "version": "0.5.0",
  "description": "Warnung vor .erebos/.onion-Adressen und Start des Erebos-Tunnels.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tunnel-guard@erebos.network"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Erebos Tunnel starten",
    "default_popup": "warning.html"
  },
  "web_accessible_resources": [
    "warning.html"
  ]
}
